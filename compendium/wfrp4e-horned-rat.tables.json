{
  "label": "Tablas (La Rata Cornuda)",
  "entries": {
    "Warpfire Thrower Fumble Table": {
      "name": "Tabla de pifias del lanzallamas de disformidad",
      "results": {
        "1-1": {
          "description": "<i>¡Bum!</i> El artefacto explota, infligiendo [[2d10+5]] de Daño a todos los que estén en un radio de 5 yardas."
        },
        "2-9": {
          "description": "<i>Fuga de combustible</i>: el combustible, altamente explosivo, se escapa y prende. Todos los que están a 3 yardas del dispositivo, incluida la tripulación, sufren dos Estados de @Condition[Ardiendo]; los que están entre 3 y 6 yardas sufren un Estado de @Condition[Ardiendo]."
        },
        "10-10": {
          "description": "<i>¡Puf!</i> El lanzallamas de disformidad no se activa, pero puede dispararse de nuevo en el siguiente asalto."
        }
      }
    },
    "Wandering Beast - Disposition": {
      "name": "Bestia errante - Disposición",
      "results": {
        "1-1": {
          "description": "Ha luchado hace poco — reduce sus Heridas un 50 %"
        },
        "2-2": {
          "description": "Intimidada — se escabulle a menos que la ataquen primero"
        },
        "3-5": {
          "description": "Territorial — se mantiene firme pero deja que los Personajes se retiren"
        },
        "6-7": {
          "description": "Adormilada — los Personajes pueden rodearla a hurtadillas o sorprenderla"
        },
        "8-8": {
          "description": "Enferma — sufre 1 Estado de @Condition[Fatigado]"
        },
        "9-9": {
          "description": "Hambrienta — deja de atacar si se le da comida"
        },
        "10-10": {
          "description": "Al acecho — ataca desde su escondite si no se la detecta con un <b>Chequeo Difícil (–20) de Percepción</b>"
        }
      }
    },
    "Skavenbrew": {
      "name": "Brebaje skaven",
      "results": {
        "1-29": {
          "description": "<i>Se echó a perder</i>. Sufres 2 Estados de @Condition[Envenenado]. El brebaje skaven no tiene ningún efecto adicional."
        },
        "30-59": {
          "description": "<i>Odio inspirado</i>. El bebedor obtiene @UUID[Compendium.wfrp4e-core.items.5hH73j2NgPdsLCZN]{Odio} hacia todos los enemigos."
        },
        "60-89": {
          "description": "<i>Frenético</i>. El bebedor queda sujeto a @UUID[Compendium.wfrp4e-core.items.DrNUTPeodEgpWTnT]{Frenesí}."
        },
        "90-100": {
          "description": "<i>Rabioso</i>. El metabolismo del bebedor alcanza un nivel hiperactivo y febril. Queda sujeto a @UUID[Compendium.wfrp4e-core.items.DrNUTPeodEgpWTnT]{Frenesí}, con los siguientes cambios.<ul><li><p>Añade +2 al Bonificador por Fuerza a efectos de calcular el Daño en todos los ataques.</p></li><li><p>El esfuerzo físico causa 1 Herida automática cada asalto.</p></li></ul>"
        }
      }
    },
    "Poisoned Wind Globe": {
      "name": "Esfera de viento envenenado",
      "results": {
        "1-1": {
          "description": "Dejas caer la esfera a tus pies, pero de alguna manera no se rompe."
        },
        "2-9": {
          "description": "La esfera cae [[1d10]] yardas antes del objetivo. Esto puede hacer que caiga detrás del lanzador, lo que indica un intento especialmente torpe."
        },
        "10-10": {
          "description": "Dejas caer la esfera a tus pies y se rompe."
        }
      }
    },
