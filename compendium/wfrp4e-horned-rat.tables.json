    "Dangerous Artifact": {
      "name": "Artefacto peligroso",
      "results": {
        "1-4": {
          "description": "<b>Campana de alarma</b>: una campana enterrada emite un tañido profundo y sonoro. Esto puede atraer <b>Refuerzos skaven</b>."
        },
        "5-6": {
          "description": "<b>Shuriken</b>: el Personaje recibe un impacto en la pierna y pierde [[1d10]] Heridas, modificadas por los Puntos de Armadura y la Resistencia. Tira además [[/r 1d10]]: con un resultado de 1–3, el shuriken también está impregnado con 1 dosis de @UUID[Compendium.wfrp4e-core.items.qfd01sggD9xbCuJY]{Loto negro}."
        },
        "7-8": {
          "description": "<b>Trampa</b>: ver @UUID[Compendium.wfrp4e-horned-rat.items.NTK53nLy10bZrjgQ]{Trampa o Cepo Lobero}"
        },
        "9-10": {
          "description": "<b>Esfera de viento envenenado</b>: una esfera de cristal verde que se rompe y libera un gas venenoso teñido de piedra bruja. Cuenta como una nube de <b>Gas apestoso</b> de 7 yardas, pero cualquiera atrapado en ella sufre además una @Corruption[Menor]{exposición menor a la Corrupción}."
        }
      }
    },
