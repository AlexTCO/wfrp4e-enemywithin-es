    "Doomrocket Fumble Table": {
      "name": "Tabla de pifias del cohete de la muerte",
      "results": {
        "1-33": {
          "description": "<i>Puf</i>: el cohete de la muerte impacta en el objetivo, pero no explota. Su Daño se reduce a +6 y pierde la Cualidad Explosión."
        },
        "34-89": {
          "description": "<i>Fuera de trayectoria</i>: algo se ha soltado y el cohete de la muerte se desvía de su curso previsto. Impacta a [[2d10]] yardas de su objetivo. Tira [[1d10]] para determinar la dirección (1–5 a la izquierda; 6–10 a la derecha)."
        },
        "90-100": {
          "description": "<i>¡Explosión!</i> El cohete de la muerte explota prematuramente, causando [[2d10+5]] de Daño a cada criatura en un radio de 5 yardas del usuario."
        }
      }
